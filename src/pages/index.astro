---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { company, services, steps, reasons } from '../site';

const pipeline = ['Search', 'Website', 'Call or form', 'Intake', 'Signed case'];
---
<Base>
  <section class="hero">
    <div class="wrap hero__in">
      <div>
        <span class="eyebrow">{company.tagline}</span>
        <h1>Signed cases, <span class="accent">not just clicks.</span></h1>
        <p class="lede">{company.description} We track every lead from first search to signed retainer, so you know what’s working.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="#contact">Get a free marketing review</a>
          <a class="btn btn--ghost" href="#services">See what we do</a>
        </div>
      </div>
      <ol class="pipe" aria-label="How a lead becomes a client">
        {pipeline.map((p, i) => <li style={`--i:${i}`}><span class="pipe__n">{String(i + 1).padStart(2, '0')}</span>{p}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h2>Everything between “lawyer near me” and a new client</h2>
      <p class="lede">Each piece works on its own. Together they make one system you can measure.</p>
      <div class="cards">
        {services.map((s) => (
          <article class="card">
            <div class="card__icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="process">
    <div class="wrap">
      <span class="eyebrow">How we work</span>
      <h2>Fix the foundations, then grow</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps__n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="why">
    <div class="wrap why">
      <div>
        <span class="eyebrow">Why {company.name}</span>
        <h2>Marketing that understands how law firms get clients</h2>
      </div>
      <dl class="reasons">
        {reasons.map((r) => (
          <div>
            <dt>{r.title}</dt>
            <dd>{r.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--dark" id="contact">
    <div class="wrap contact-sec">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>Let’s look at where your next clients will come from</h2>
        <p class="lede">Tell us about your firm. We’ll review your website, search presence and ads, and come back with what we’d change first.</p>
        {company.email && <p>Prefer email? <a href={`mailto:${company.email}`}>{company.email}</a></p>}
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .accent { color: var(--accent); }

  .hero { background: var(--ink); color: var(--on-dark); padding: clamp(72px, 11vw, 140px) 0 clamp(72px, 10vw, 128px); position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(600px 400px at 85% 20%, rgb(255 90 31 / 18%), transparent 70%),
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 48px 48px;
  }
  .hero__in { position: relative; display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  .hero h1 { color: #fff; }
  .hero .lede { color: var(--on-dark); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero .btn--ghost { color: #fff; }

  .pipe { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .pipe li {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 20px; border-radius: 14px;
    background: rgb(255 255 255 / 5%); border: 1px solid rgb(255 255 255 / 10%);
    color: #fff; font: 650 1.05rem/1.2 var(--body);
    margin-left: calc(var(--i) * 14px);
    animation: rise .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 90ms);
  }
  .pipe li:last-child { background: var(--accent); border-color: var(--accent); }
  .pipe__n { font: 700 0.75rem/1 var(--body); letter-spacing: 0.08em; color: var(--accent); }
  .pipe li:last-child .pipe__n { color: rgb(255 255 255 / 75%); }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) { .pipe li { animation: none; } }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 48px; }
  .card { border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .card:hover { border-color: transparent; box-shadow: var(--shadow); transform: translateY(-2px); }
  .card__icon { width: 52px; height: 52px; border-radius: 12px; display: grid; place-items: center; background: var(--accent-tint); color: var(--accent); margin-bottom: 20px; }
  .card p { color: var(--muted); margin: 0; font-size: 0.98rem; }

  .steps { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: s; }
  .steps li { background: #fff; border-radius: var(--radius); padding: 32px 28px; box-shadow: var(--shadow); }
  .steps__n { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; font: 700 1rem/1 var(--display); margin-bottom: 18px; }
  .steps p { color: var(--muted); margin: 0; }

  .why { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .reasons { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 32px 28px; }
  .reasons div { border-top: 3px solid var(--accent); padding-top: 16px; }
  .reasons dt { font: 720 1.15rem/1.2 var(--display); font-stretch: 115%; color: var(--ink); margin-bottom: 8px; }
  .reasons dd { margin: 0; color: var(--muted); }

  .contact-sec { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .contact-sec a { color: #fff; }

  @media (max-width: 900px) {
    .hero__in, .why, .contact-sec { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .reasons { grid-template-columns: 1fr; }
    .pipe li { margin-left: calc(var(--i) * 8px); }
  }
</style>
