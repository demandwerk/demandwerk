---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { company, whatWeDo, guarantees, steps, reasons } from '../site';

const pipeline = ['Search', 'Website', 'Call or form', 'Intake', 'Signed case'];
---
<Base>
  <section class="hero">
    <div class="wrap hero__in">
      <div>
        <span class="eyebrow">{company.tagline}</span>
        <h1>Marketing that hits <span class="accent"><em>your</em> goals.</span></h1>
        <p class="hero__no">No slogan. No specialty. Not a niche agency.</p>
        <p class="lede">{company.description}</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="/contact/">Free consult, no badgering</a>
          <a class="btn btn--ghost" href="#what-we-do">See what we do</a>
        </div>
      </div>
      <ol class="pipe" aria-label="How a lead becomes a client">
        {pipeline.map((p, i) => <li style={`--i:${i}`}><span class="pipe__n">{String(i + 1).padStart(2, '0')}</span>{p}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="what-we-do">
    <div class="wrap">
      <span class="eyebrow">What we do</span>
      <h2>We hate platitudes. Here’s what we do, in plain language.</h2>
      <ol class="do">
        {whatWeDo.map((d) => (
          <li>
            <p class="do__text">{d.text}</p>
            <div class="do__links">
              {d.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
            </div>
          </li>
        ))}
      </ol>
      <a class="all" href="/services/">See all services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section guarantee">
    <div class="wrap">
      <span class="eyebrow">We guarantee</span>
      <dl class="g">
        {guarantees.map((g) => (
          <div>
            <dt>{g.title}</dt>
            <dd>{g.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--tint" id="process">
    <div class="wrap">
      <span class="eyebrow">How we work</span>
      <h2>Fix the foundations, then grow</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps__n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="why">
    <div class="wrap why">
      <div>
        <span class="eyebrow">Why {company.name}</span>
        <h2>Marketing that understands how law firms get clients</h2>
      </div>
      <dl class="reasons">
        {reasons.map((r) => (
          <div>
            <dt>{r.title}</dt>
            <dd>{r.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section contact-bg" id="contact">
    <div class="wrap contact-sec">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>Let’s look at where your next clients will come from</h2>
        <p class="lede">Tell us about your firm. We’ll review your website, search presence and ads, and come back with what we’d change first.</p>
        {company.email && <p>Prefer email? <a href={`mailto:${company.email}`}>{company.email}</a></p>}
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .accent { color: var(--accent); }

  .hero { background: var(--tint); color: var(--text); padding: clamp(72px, 11vw, 140px) 0 clamp(72px, 10vw, 128px); position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(600px 400px at 85% 20%, rgb(181 121 58 / 20%), transparent 70%),
      linear-gradient(rgb(26 26 26 / 4%) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(26 26 26 / 4%) 1px, transparent 1px) 0 0 / 48px 48px;
  }
  .hero__in { position: relative; display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  .hero__no { font: 700 clamp(1.05rem, 1.8vw, 1.3rem)/1.3 var(--display); font-stretch: 112%; color: var(--ink); margin: 4px 0 14px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero .btn--ghost { color: var(--ink); }

  .pipe { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .pipe li {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 20px; border-radius: 14px;
    background: #fff; border: 1px solid var(--line); box-shadow: 0 1px 2px rgb(26 26 26 / 5%);
    color: var(--ink); font: 650 1.05rem/1.2 var(--body);
    margin-left: calc(var(--i) * 14px);
    animation: rise .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 90ms);
  }
  .pipe li:last-child { background: var(--accent-strong); border-color: var(--accent-strong); color: #fff; }
  .pipe__n { font: 700 0.75rem/1 var(--body); letter-spacing: 0.08em; color: var(--teal); }
  .pipe li:last-child .pipe__n { color: rgb(255 255 255 / 75%); }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) { .pipe li { animation: none; } }

  #what-we-do h2 { max-width: 22ch; }
  .do { list-style: none; margin: 40px 0 0; padding: 0; counter-reset: do; }
  .do li {
    counter-increment: do;
    display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 12px 24px;
    padding: 26px 0; border-top: 1px solid var(--line);
  }
  .do li:last-child { border-bottom: 1px solid var(--line); }
  .do li::before { content: counter(do, decimal-leading-zero); font: 700 0.85rem/1 var(--body); letter-spacing: 0.08em; color: var(--teal); }
  .do__text { margin: 0; font: 700 clamp(1.2rem, 2.2vw, 1.6rem)/1.25 var(--display); font-stretch: 112%; color: var(--ink); letter-spacing: -0.01em; }
  .do__links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .do__links a { display: inline-block; padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--accent); color: var(--accent-strong); font-weight: 650; font-size: 0.92rem; text-decoration: none; white-space: nowrap; transition: background .15s, color .15s; }
  .do__links a:hover { background: var(--accent-strong); border-color: var(--accent-strong); color: #fff; }
  .all { display: inline-block; margin-top: 32px; font-weight: 650; color: var(--accent-strong); text-decoration: none; }
  .all:hover { text-decoration: underline; }

  .guarantee { background: var(--accent-tint); }
  .g { margin: 8px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px 28px; }
  .g dt { font: 800 clamp(1.5rem, 2.6vw, 2.1rem)/1.1 var(--display); font-stretch: 115%; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 12px; }
  .g dt::before { content: ''; display: block; width: 40px; height: 4px; border-radius: 2px; background: var(--accent); margin-bottom: 18px; }
  .g dd { margin: 0; color: var(--muted); }

  .steps { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps li { background: #fff; border-radius: var(--radius); padding: 32px 28px; box-shadow: var(--shadow); }
  .steps__n { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--teal); color: #fff; font: 700 1rem/1 var(--display); margin-bottom: 18px; }
  .steps p { color: var(--muted); margin: 0; }

  .why { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .reasons { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 32px 28px; }
  .reasons div { border-top: 3px solid var(--accent); padding-top: 16px; }
  .reasons dt { font: 720 1.15rem/1.2 var(--display); font-stretch: 115%; color: var(--ink); margin-bottom: 8px; }
  .reasons dd { margin: 0; color: var(--muted); }

  .contact-sec { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .contact-bg { background: var(--teal-tint); }

  @media (max-width: 900px) {
    .hero__in, .why, .contact-sec { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
    .g { grid-template-columns: 1fr 1fr; }
    .do li { grid-template-columns: 40px 1fr; }
    .do__links { grid-column: 2; justify-content: flex-start; }
  }
  @media (max-width: 520px) {
    .reasons, .g { grid-template-columns: 1fr; }
    .pipe li { margin-left: calc(var(--i) * 8px); }
  }
</style>
