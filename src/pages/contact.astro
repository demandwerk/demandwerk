---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../site';
---
<Base title="Contact Us" description="Tell us about your business and your goals. We’ll come back with what we’d do first.">
  <PageHero title="Let’s chat" blurb="Tell us about your business and where you want to grow. We’ll review where you stand and come back with what we’d change first." cta={false} />
  <section class="section">
    <div class="wrap contact">
      <div>
        <h2>What happens next</h2>
        <ol>
          <li>We read what you send and look at your website, search presence and ads.</li>
          <li>We set up a short call to talk through your goals.</li>
          <li>You get a plain-language recommendation, whether or not you hire us.</li>
        </ol>
        {company.email && <p>Prefer email? <a href={`mailto:${company.email}`}>{company.email}</a></p>}
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  ol { padding-left: 1.2em; color: var(--muted); }
  li { margin-bottom: 10px; }
  li::marker { color: var(--accent-strong); font-weight: 700; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
