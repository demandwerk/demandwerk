---
// Cards linking to pages in the site map, with their sub-pages listed underneath.
import type { PageNode } from '../site';
interface Props { items: PageNode[]; base: string } // base: URL of the parent page, e.g. '/services/'
const { items, base } = Astro.props;
---
<div class="cards">
  {items.map((item) => {
    const href = `${base}${item.slug}/`;
    return (
      <article class="card">
        <h3><a href={href}>{item.title}</a></h3>
        <p>{item.blurb}</p>
        {item.children && (
          <ul>
            {item.children.map((c) => <li><a href={`${href}${c.slug}/`}>{c.menuTitle ?? c.title}</a></li>)}
          </ul>
        )}
        <a class="card__more" href={href} aria-hidden="true" tabindex="-1">Learn more <span>→</span></a>
      </article>
    );
  })}
</div>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 20px; }
  .card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; background: #fff; transition: border-color .15s, box-shadow .15s; }
  .card:hover { border-color: transparent; box-shadow: var(--shadow); }
  .card h3 { margin-bottom: 10px; }
  .card h3 a { text-decoration: none; }
  .card h3 a:hover { color: var(--accent-strong); }
  .card p { color: var(--muted); font-size: 0.98rem; margin: 0 0 16px; }
  ul { list-style: none; margin: 0 0 18px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  li a { display: inline-block; padding: 5px 11px; border-radius: 999px; background: var(--teal-tint); color: var(--teal-strong); font-size: 0.82rem; font-weight: 600; text-decoration: none; }
  li a:hover { background: var(--teal); color: #fff; }
  .card__more { margin-top: auto; font-size: 0.92rem; font-weight: 650; color: var(--accent-strong); text-decoration: none; }
  .card__more span { display: inline-block; transition: transform .15s; }
  .card:hover .card__more span { transform: translateX(3px); }
</style>
