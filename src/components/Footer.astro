---
import Logo from './Logo.astro';
import { company, nav } from '../site';
---
<footer class="ftr">
  <div class="wrap ftr__in">
    <div class="ftr__brand">
      <Logo />
      <p>{company.tagline}</p>
      <a class="btn btn--primary" href="/contact/">Let’s chat</a>
      {company.email && <p><a href={`mailto:${company.email}`}>{company.email}</a></p>}
    </div>
    {nav.map((item) => (
      <div class="ftr__col">
        <a class="ftr__head" href={item.href}>{item.label}</a>
        <ul>
          {item.node?.children?.map((c) => <li><a href={`${item.href}${c.slug}/`}>{c.menuTitle ?? c.title}</a></li>)}
          {item.links?.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap ftr__legal">© {new Date().getFullYear()} {company.name}</div>
</footer>

<style>
  .ftr { background: var(--tint); color: var(--muted); padding: 64px 0 28px; border-top: 1px solid var(--line); }
  .ftr__in { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); gap: 36px 28px; }
  .ftr__brand p { margin: 14px 0 20px; font-size: 0.95rem; }
  .ftr__brand .btn { padding: 12px 20px; font-size: 0.92rem; }
  .ftr__head { display: block; font: 700 1rem/1.2 var(--display); font-stretch: 112%; color: var(--ink); text-decoration: none; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  ul a { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
  a:hover { color: var(--accent-strong); }
  .ftr__legal { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 0.85rem; }
  @media (max-width: 900px) { .ftr__in { grid-template-columns: 1fr 1fr; } .ftr__brand { grid-column: 1 / -1; } }
</style>
