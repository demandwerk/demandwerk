---
import Logo from './Logo.astro';
import { company, nav } from '../site';
---
<footer class="ftr">
  <div class="wrap ftr__in">
    <div>
      <Logo />
      <p class="ftr__tag">{company.tagline}</p>
    </div>
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href="/#contact">Contact</a></li>
      {company.email && <li><a href={`mailto:${company.email}`}>{company.email}</a></li>}
    </ul>
  </div>
  <div class="wrap ftr__legal">© {new Date().getFullYear()} {company.name}</div>
</footer>

<style>
  .ftr { background: var(--tint); color: var(--muted); padding: 56px 0 28px; border-top: 1px solid var(--line); }
  .ftr__in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px; }
  .ftr__tag { margin: 12px 0 0; font-size: 0.95rem; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: start; }
  ul a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  ul a:hover { color: var(--ink); }
  .ftr__legal { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
</style>
